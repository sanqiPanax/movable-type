  {
    "id": "2110918113550307778",
    "text": "This paper shows why I am skeptical of the idea that frontier models can be easily replaced by cheaper ones (and why you should use the best models as orchestrators): Small improvements in accuracy &amp; judgement compound over long-horizon tasks, creating huge gains in outcomes. https://t.co/2P4Eq6RkcN",
    "author": {
      "id": "39125788",
      "name": "Ethan Mollick",
      "screenName": "emollick",
      "profileImageUrl": "https://pbs.twimg.com/profile_images/1601382188712398850/3AAOlqrX_normal.jpg",
      "verified": true
    },
    "metrics": {
      "likes": 1173,
      "retweets": 110,
      "replies": 190,
      "quotes": 28,
      "views": 61108,
      "bookmarks": 478
    },
    "createdAt": "Fri Oct 16 02:17:51 +0000 2026",
    "createdAtLocal": "2026-10-16 10:17",
    "createdAtISO": "2026-10-16T02:17:51+00:00",
    "media": [
      {
        "type": "photo",
        "url": "https://pbs.twimg.com/media/HUt8ufXWkAAvwuY.png",
        "width": 664,
        "height": 315
      },
      {
        "type": "photo",
        "url": "https://pbs.twimg.com/media/HUt8ybHXMAEdgKO.png",
        "width": 811,
        "height": 841
      }
    ],
    "urls": [],
