  {
    "id": "2110841898076418336",
    "text": "We're expanding access to GPT-Rosalind for academic research.\n\nThe new Rosalind Academic Plan helps scientific labs bring AI into the work of understanding biology, exploring ideas, and deciding what to test next—with sponsored access for eligible labs at U.S. universities.\n\nAcademic research starts with questions whose impact may take years to impact human health.",
    "author": {
      "id": "4398626122",
      "name": "OpenAI",
      "screenName": "OpenAI",
      "profileImageUrl": "https://pbs.twimg.com/profile_images/1885410181409820672/ztsaR0JW_normal.jpg",
      "verified": true
    },
    "metrics": {
      "likes": 3099,
      "retweets": 285,
      "replies": 299,
      "quotes": 101,
      "views": 331064,
      "bookmarks": 561
    },
    "createdAt": "Thu Oct 15 21:15:00 +0000 2026",
    "createdAtLocal": "2026-10-16 05:15",
    "createdAtISO": "2026-10-15T21:15:00+00:00",
    "media": [
      {
        "type": "video",
        "url": "https://video.twimg.com/amplify_video/2110841872742858752/vid/avc1/1920x1080/rjivINa_ojhDJasO.mp4?tag=29",
        "width": 1920,
        "height": 1080
      }
    ],
    "urls": [],
    "isRetweet": false,
    "retweetedBy": null,
    "lang": "en",
    "score": null
  },
  {
    "id": "2110841899838046525",
    "text": "GPT-Rosalind is built to support that work: helping researchers reason across scientific literature and biological data, with scientists bringing the expertise and judgment to evaluate the evidence.\n\nEligible labs can receive up to 12 months of sponsored access to OpenAI tools, with GPT-Rosalind access subject to trusted-access approval.\n\nResearch data shared through the Rosalind Academic Plan is not used to train our models by default.",
    "author": {
      "id": "4398626122",
      "name": "OpenAI",
      "screenName": "OpenAI",
      "profileImageUrl": "https://pbs.twimg.com/profile_images/1885410181409820672/ztsaR0JW_normal.jpg",
      "verified": true
    },
    "metrics": {
      "likes": 278,
      "retweets": 13,
      "replies": 31,
      "quotes": 2,
      "views": 90155,
      "bookmarks": 13
